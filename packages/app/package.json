{
  "name": "@aics/vole-app",
  "version": "3.8.0",
  "description": "web viewer for 3D volume data",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./types/index.d.ts",
      "default": "./es/index.js"
    }
  },
  "files": [
    "es",
    "types",
    "README.md",
    "package.json"
  ],
  "homepage": "https://github.com/allen-cell-animated/vole-app#readme",
  "bugs": {
    "url": "https://github.com/allen-cell-animated/vole-app/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allen-cell-animated/vole-app.git"
  },
  "scripts": {
    "gh-build-nightly": "vite build --base=/vole-app/",
    "s3-build": "vite build",
    "release-build": "vite build",
    "dev": "vite dev",
    "lint": "eslint --config ./.eslintrc --ignore-path ./.eslintignore --ext .jsx --ext .js --ext .ts --ext .tsx ./",
    "lint-fix": "eslint --fix --config ./.eslintrc --ignore-path ./.eslintignore --ext .jsx --ext .js --ext .ts --ext .tsx ./",
    "test": "vitest run --passWithNoTests",
    "typeCheck": "tsc -b --noEmit",
    "generateTypes": "tsc -b",
    "transpileES": "cross-env BABEL_ENV=es VOLEAPP_VERSION=$npm_package_version babel src -d es -x \".js,.jsx,.ts,.tsx,.svg\" --ignore src/**/*.test.* --root-mode upward",
    "build": "npm-run-all generateTypes postcss transpileES",
    "postcss": "postcss src/**/*.css --base src --dir es",
    "publish-patch": "npm version patch | xargs -I {} sh -c 'git push origin {}'",
    "postpublish-patch": "git push origin main",
    "prepare": "cross-env DEPLOYMENT_ENV=production npm run build",
    "predeploy": "cross-env DEPLOYMENT_ENV=production npm run release-build",
    "deploy": "gh-pages -d imageviewer -t true",
    "checks": "npm run lint && npm run typeCheck && npm run test"
  },
  "author": "Allen Institute, Cell Science",
  "type": "commonjs",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@aics/vole-core": "^4.10.1",
    "@ant-design/icons": "^6.3.4",
    "d3": "^7.9.0",
    "gl-matrix": "^3.4.4",
    "lodash": "^4.17.20",
    "nouislider-react": "^3.4.2",
    "react-color": "^2.19.3",
    "styled-components": "^6.1.13",
    "three": "0.184.0",
    "zustand": "^5.0.6"
  },
  "peerDependencies": {
    "antd": "^6.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/lodash": "^4.14.185",
    "@types/react": "^19.2.18",
    "@types/react-color": "^3.0.12",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.184.0"
  }
}
