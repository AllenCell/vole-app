{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "downlevelIteration": true,
    "jsx": "preserve",
    "lib": ["DOM", "ES2022", "ES6", "DOM.Iterable", "ScriptHost", "es2016.array.include"],
    "module": "es2022",
    "moduleResolution": "Node",
    "target": "es2017",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true
  },
  "files": [],
  "references": [{ "path": "packages/app" }, { "path": "packages/website" }]
}
